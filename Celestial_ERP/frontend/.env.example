DJANGO_BACKEND_URL=http://127.0.0.1:8000
# Next.js escucha en 0.0.0.0:3000; Django permanece privado y se accede por proxy.

# SMTP para /contacto y /trabaja-con-nosotros (servidor de correo del proveedor elegido)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contacto@celestial-erp.local
SMTP_PASSWORD=pon-la-clave-en-tu-entorno-local
SMTP_FROM=Celestial ERP <contacto@celestial-erp.local>
CONTACT_TO=administracion@celestial-erp.local

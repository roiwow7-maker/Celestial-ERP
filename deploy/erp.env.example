ERP_SETTINGS_ENV=prod
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=erp.example.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.example.cl
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
POSTGRES_DB=celestial_erp
POSTGRES_USER=celestial_app
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
ERP_AUTO_BACKUP_ENABLED=false
